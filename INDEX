<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Thực hành Form HTML</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f6f8;
      padding: 30px;
    }
    .form-container {
      max-width: 500px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 24px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    h2 {
      text-align: center;
      color: #1a73e8;
      margin-top: 0;
    }
    .form-group {
      margin-bottom: 16px;
    }
    label {
      display: block;
      font-weight: bold;
      margin-bottom: 6px;
    }
    .form-group input[type="text"],
    .form-group input[type="password"],
    .form-group select {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid #ccc;
      border-radius: 4px;
      box-sizing: border-box;
    }
    .inline-group label {
      display: inline-block;
      font-weight: normal;
      margin-right: 15px;
    }
    .btn-group {
      display: flex;
      gap: 10px;
      margin-top: 20px;
    }
    input[type="submit"], input[type="button"] {
      padding: 9px 18px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
    }
    input[type="submit"] {
      background-color: #1a73e8;
      color: white;
    }
    input[type="button"] {
      background-color: #e0e0e0;
      color: #333;
    }
  </style>
</head>
<body>

  <div class="form-container">
    <h2>PHIẾU ĐĂNG KÝ HỌC SINH</h2>
    
    <form action="#" method="post">
      <!-- 1. Text input -->
      <div class="form-group">
        <label for="fullname">Họ và tên:</label>
        <input type="text" id="fullname" name="fullname" placeholder="Nhập đầy đủ họ tên...">
      </div>

      <!-- 2. Password input -->
      <div class="form-group">
        <label for="pwd">Mật khẩu:</label>
        <input type="password" id="pwd" name="pwd" placeholder="Nhập mật khẩu">
      </div>

      <!-- 3. Radio button -->
      <div class="form-group inline-group">
        <label>Giới tính:</label>
        <input type="radio" id="male" name="gender" value="Nam" checked>
        <label for="male">Nam</label>
        <input type="radio" id="female" name="gender" value="Nữ">
        <label for="female">Nữ</label>
      </div>

      <!-- 4. Select menu -->
      <div class="form-group">
        <label for="grade">Khối lớp:</label>
        <select id="grade" name="grade">
          <option value="10">10</option>
          <option value="11">11</option>
          <option value="12">12</option>
        </select>
      </div>

      <!-- 5. Checkbox -->
      <div class="form-group inline-group">
        <label>Môn học yêu thích:</label><br>
        <input type="checkbox" id="math" name="subjects" value="Toán">
        <label for="math">Toán</label>
        
        <input type="checkbox" id="it" name="subjects" value="Tin học" checked>
        <label for="it">Tin học</label>
        
        <input type="checkbox" id="english" name="subjects" value="Tiếng Anh">
        <label for="english">Tiếng Anh</label>
      </div>

      <!-- 6. File upload -->
      <div class="form-group">
        <label for="avatar">Tải hồ sơ / ảnh minh họa:</label>
        <input type="file" id="avatar" name="avatar">
      </div>

      <!-- 7. Button & Submit -->
      <div class="btn-group">
        <input type="submit" value="Gửi thông tin">
        <input type="button" value="Kiểm tra" onclick="alert('Biểu mẫu hoạt động tốt!')">
      </div>
    </form>
  </div>

</body>
</html>
